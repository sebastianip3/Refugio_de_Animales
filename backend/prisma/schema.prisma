generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  MACHO
  HEMBRA
  DESCONOCIDO
}

enum EstadoAnimal {
  EN_EVALUACION
  CUARENTENA
  EN_TRATAMIENTO
  EN_ADOPCION
  ADOPTADO
  OTRO
}

enum TipoRegistroClinico {
  CONSULTA
  VACUNA
  DESPARASITACION
  CIRUGIA
  ESTERILIZACION
  TRATAMIENTO
  EXAMEN
  OTRO
}

// PENDIENTE y EN_REVISION cuentan como "adopción en proceso"
// Las solicitudes no se cancelan: "Rechazar" cumple esa función
enum EstadoAdopcion {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
}

// Estado de una visita post adopción. El encargado puede cancelarla antes de su fecha
// o registrar su resultado (REALIZADA) cuando llega la fecha
enum EstadoVisita {
  AGENDADA
  CANCELADA
  REALIZADA
}

// Cómo se encontró al animal en la visita
enum EstadoAnimalVisita {
  BIEN
  REGULAR
  CON_PROBLEMAS
}

// Comunas donde el refugio acepta adopciones
enum Comuna {
  CONCEPCION
  CORONEL
  CHIGUAYANTE
  FLORIDA
  HUALQUI
  LOTA
  PENCO
  SAN_PEDRO_DE_LA_PAZ
  SANTA_JUANA
  TALCAHUANO
}

enum TipoVivienda {
  CASA_CON_PATIO
  CASA_SIN_PATIO
  CABANA
  DEPARTAMENTO
  CONDOMINIO
}

enum TamanoMascota {
  PEQUENO
  MEDIANO
  GRANDE
}

// El sistema solo crea la inscripción si queda cupo, por eso nace CONFIRMADA.
// CANCELADA es la única que no ocupa cupo.
enum EstadoInscripcion {
  CONFIRMADA
  ASISTIO
  NO_ASISTIO
  CANCELADA
}

// Envío automático del comprobante. FALLIDO queda pendiente de reintento.
enum EstadoCorreo {
  PENDIENTE
  ENVIADO
  FALLIDO
}

enum TipoCuenta {
  ADMINISTRADOR
  VOLUNTARIO
  TRABAJADOR
  ENCARGADO_ADOPCIONES
  VETERINARIO
}

enum CategoriaInsumo {
  ALIMENTO
  MEDICAMENTO
  OTRO
}

enum TipoMovimientoInsumo {
  INGRESO
  RETIRO
  CONSUMO
}

enum TipoEvento {
  ADOPCION
  OTRO
}

enum EstadoEvento {
  PROGRAMADO
  CANCELADO
  FINALIZADO
}

model Cuenta {
  id                Int        @id @default(autoincrement())
  nombre            String     @db.VarChar(100)
  apellido          String     @db.VarChar(100)
  tipo              TipoCuenta @default(VOLUNTARIO)
  correo            String     @unique @db.VarChar(254)
  contrasenaHash    String     @db.VarChar(20)
  horario           String?    @db.VarChar(255)
  disponibleCuidado Boolean?   @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  cuidados                   CuidadoAnimal[]
  movimientosInsumos         MovimientoInsumo[]
  disponibilidadesVoluntario DisponibilidadVoluntario[]
  turnosVoluntario           TurnoVoluntario[]
  registrosClinicos          RegistroClinico[]

  @@index([tipo, disponibleCuidado])
  @@map("cuentas")
}

model DisponibilidadVoluntario {
  id        Int      @id @default(autoincrement())
  diaSemana Int
  hora      Int
  createdAt DateTime @default(now())

  cuentaId Int
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@unique([cuentaId, diaSemana, hora])
  @@index([diaSemana, hora])
  @@map("disponibilidades_voluntarios")
}

model TurnoVoluntario {
  id        Int      @id @default(autoincrement())
  diaSemana Int
  hora      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuentaId Int
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@unique([diaSemana, hora])
  @@index([cuentaId])
  @@map("turnos_voluntarios")
}

model Especie {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animales      Animal[]
  inscripciones InscripcionEsterilizacion[]

  @@map("especies")
}

// Varios campos opcionales: hay animales que llegan sin antecedentes.
model Animal {
  id              Int          @id @default(autoincrement())
  nombre          String?      @db.VarChar(30)
  fechaNacimiento DateTime?
  sexo            Sexo         @default(DESCONOCIDO)
  cambioSexo      Int          @default(0)
  peso            Float?
  estadoGeneral   String?      @db.Text
  fotografiaUrl   String?      @db.VarChar(500)
  estado          EstadoAnimal @default(EN_EVALUACION)
  tieneChip       Boolean?
  numeroChip      String?      @db.VarChar(15)
  observaciones   String?      @db.Text
  fechaIngreso    DateTime     @default(now())
  fechaEgreso     DateTime?
  motivoEgreso    String?      @db.VarChar(100)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  especieId Int
  especie   Especie @relation(fields: [especieId], references: [id], onDelete: Restrict)

  adopciones        Adopcion[]
  registrosClinicos RegistroClinico[]
  cuidados          CuidadoAnimal[]

  @@index([estado])
  @@map("animales")
}

model CuidadoAnimal {
  id          Int      @id @default(autoincrement())
  fechaInicio DateTime
  fechaFin    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animalId Int
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)
  cuentaId Int
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id], onDelete: Restrict)

  @@index([animalId, fechaInicio, fechaFin])
  @@index([cuentaId, fechaInicio, fechaFin])
  @@map("cuidados_animales")
}

model Adopcion {
  id             Int            @id @default(autoincrement())
  nombre         String
  rut            String
  email          String
  telefono       String
  direccion      String
  comuna         Comuna
  tipoVivienda   TipoVivienda?
  otrasMascotas  String?
  motivo         String?
  estado         EstadoAdopcion @default(PENDIENTE)
  observaciones  String?
  fechaSolicitud DateTime       @default(now())

  animalId Int
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  visitas VisitaAdopcion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId, estado])
  @@map("adopciones")
}

// Visita post adopción que agenda el encargado después de aprobar una adopción
model VisitaAdopcion {
  id            Int                 @id @default(autoincrement())
  fecha         DateTime
  // "HH:MM", uno de los horarios fijos (10:00, 12:00 o 15:00). Las visitas anteriores a este campo no tienen hora
  hora          String?             @db.VarChar(5)
  estado        EstadoVisita        @default(AGENDADA)
  // Resultado de la visita: se llenan al registrarla
  estadoAnimal  EstadoAnimalVisita?
  observaciones String?             @db.Text
  createdAt     DateTime            @default(now())

  adopcionId Int
  adopcion   Adopcion @relation(fields: [adopcionId], references: [id], onDelete: Restrict)

  @@index([adopcionId, fecha])
  @@map("visitas_adopcion")
}

// Antecedente veterinario de un animal. Los adoptantes solo pueden consultarlo
model RegistroClinico {
  id            Int                 @id @default(autoincrement())
  fecha         DateTime            @default(now())
  tipo          TipoRegistroClinico
  descripcion   String              @db.Text
  diagnostico   String?             @db.Text
  tratamiento   String?             @db.Text
  observaciones String?             @db.Text
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  animalId Int
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  // Veterinario responsable: una cuenta de tipo VETERINARIO del refugio.
  // Si la cuenta se elimina, el registro se conserva sin veterinario
  veterinarioId Int?
  veterinario   Cuenta? @relation(fields: [veterinarioId], references: [id], onDelete: SetNull)

  @@index([animalId, fecha])
  @@index([veterinarioId])
  @@map("registros_clinicos")
}

// El formulario solo acepta inscripciones mientras la jornada esté activa y queden cupos.
model JornadaEsterilizacion {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(150)
  fecha        DateTime
  lugar        String   @db.VarChar(255)
  comuna       String   @db.VarChar(100)
  sector       String   @db.VarChar(100)
  cuposTotales Int
  activa       Boolean  @default(false)

  // El sistema las incluye en el correo de confirmación
  indicacionesPostOperatorias String   @db.Text
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  inscripciones InscripcionEsterilizacion[]

  @@index([activa, fecha])
  @@map("jornadas_esterilizacion")
}

model InscripcionEsterilizacion {
  id     Int               @id @default(autoincrement())
  estado EstadoInscripcion @default(CONFIRMADA)

  // Folio impreso en el comprobante PDF
  codigoComprobante String @unique @db.VarChar(20)

  // Datos de la mascota
  sexo         Sexo
  tamano       TamanoMascota
  pesoEstimado Float

  especieId Int
  especie   Especie @relation(fields: [especieId], references: [id], onDelete: Restrict)

  // Datos del tutor
  tutorNombre   String @db.VarChar(100)
  tutorApellido String @db.VarChar(100)
  tutorRut      String @db.VarChar(12)
  tutorEmail    String @db.VarChar(150)
  tutorComuna   String @db.VarChar(100)
  tutorSector   String @db.VarChar(100)

  // Notas de la administradora
  observaciones String? @db.Text

  // Lo actualiza el sistema al enviar el comprobante, un fallo no anula la inscripción
  estadoCorreo     EstadoCorreo @default(PENDIENTE)
  intentosCorreo   Int          @default(0)
  fechaEnvioCorreo DateTime?
  errorCorreo      String?      @db.Text

  jornadaId Int
  jornada   JornadaEsterilizacion @relation(fields: [jornadaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jornadaId, estado])
  @@index([tutorRut])
  @@index([estadoCorreo])
  @@map("inscripciones_esterilizacion")
}

model Insumo {
  id           Int             @id @default(autoincrement())
  nombre       String          @db.VarChar(150)
  categoria    CategoriaInsumo
  descripcion  String?         @db.Text
  unidadMedida String          @db.VarChar(30)
  stockActual  Decimal         @default(0) @db.Decimal(12, 2)
  stockMinimo  Decimal         @default(0) @db.Decimal(12, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  movimientos MovimientoInsumo[]

  @@index([categoria])
  @@map("insumos")
}

model MovimientoInsumo {
  id          Int                  @id @default(autoincrement())
  tipo        TipoMovimientoInsumo
  cantidad    Decimal              @db.Decimal(12, 2)
  observacion String?              @db.Text
  fecha       DateTime             @default(now())

  insumoId Int
  insumo   Insumo @relation(fields: [insumoId], references: [id], onDelete: Restrict)

  realizadoPorId Int
  realizadoPor   Cuenta @relation(fields: [realizadoPorId], references: [id], onDelete: Restrict)

  @@index([insumoId, fecha])
  @@index([realizadoPorId])
  @@map("movimientos_insumos")
}

model Evento {
  id           Int          @id @default(autoincrement())
  nombre       String       @db.VarChar(150)
  tipo         TipoEvento   @default(ADOPCION)
  descripcion  String       @db.Text
  fecha        DateTime
  lugar        String       @db.VarChar(255)
  comuna       String       @db.VarChar(100)
  cuposTotales Int?
  estado       EstadoEvento @default(PROGRAMADO)
  publicado    Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicado, fecha])
  @@map("eventos")
}
