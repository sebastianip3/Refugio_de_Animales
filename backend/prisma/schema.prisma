generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  MACHO
  HEMBRA
  DESCONOCIDO
}

enum EstadoAnimal {
  EN_EVALUACION
  CUARENTENA
  EN_TRATAMIENTO
  EN_ADOPCION
  ADOPTADO
  OTRO
}

// PENDIENTE y EN_REVISION cuentan como "adopción en proceso"
enum EstadoAdopcion {
  PENDIENTE
  EN_REVISION
  APROBADA
  RECHAZADA
  CANCELADA
}

enum TamanoMascota {
  PEQUENO
  MEDIANO
  GRANDE
}

// PENDIENTE: llenó el formulario. CITADA: la administradora le envió el comprobante.
// RECHAZADA y CANCELADA no ocupan cupo.
enum EstadoInscripcion {
  PENDIENTE
  CITADA
  ASISTIO
  NO_ASISTIO
  RECHAZADA
  CANCELADA
}

model Especie {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(80)
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animales      Animal[]
  inscripciones InscripcionEsterilizacion[]

  @@map("especies")
}

// Varios campos opcionales: hay animales que llegan sin antecedentes.
model Animal {
  id            Int          @id @default(autoincrement())
  nombre        String?      @db.VarChar(100)
  edadEstimada  Int?
  sexo          Sexo         @default(DESCONOCIDO)
  peso          Float?
  estadoGeneral String?      @db.Text
  fotografiaUrl String?      @db.VarChar(500)
  estado        EstadoAnimal @default(EN_EVALUACION)
  tieneChip     Boolean?
  numeroChip    String?      @db.VarChar(50)
  observaciones String?      @db.Text
  fechaIngreso  DateTime     @default(now())
  fechaEgreso   DateTime?
  motivoEgreso  String?      @db.VarChar(255)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  especieId Int
  especie   Especie @relation(fields: [especieId], references: [id], onDelete: Restrict)

  adopciones Adopcion[]

  @@index([estado])
  @@map("animales")
}

model Adopcion {
  id             Int            @id @default(autoincrement())
  nombre         String
  rut            String
  email          String
  telefono       String
  direccion      String
  comuna         String
  tipoVivienda   String?
  otrasMascotas  String?
  motivo         String?
  estado         EstadoAdopcion @default(PENDIENTE)
  observaciones  String?
  fechaSolicitud DateTime       @default(now())

  animalId Int
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId, estado])
  @@map("adopciones")
}

// El formulario solo acepta inscripciones mientras la jornada esté activa y queden cupos.
model JornadaEsterilizacion {
  id                          Int      @id @default(autoincrement())
  nombre                      String   @db.VarChar(150)
  fecha                       DateTime
  lugar                       String   @db.VarChar(255)
  comuna                      String   @db.VarChar(100)
  sector                      String?  @db.VarChar(100)
  cuposTotales                Int
  activa                      Boolean  @default(true)
  // Se envían en el comprobante de citación
  indicacionesPostOperatorias String   @db.Text
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  inscripciones InscripcionEsterilizacion[]

  @@index([activa, fecha])
  @@map("jornadas_esterilizacion")
}

// La mascota no se registra como Animal: es de la comunidad, no del refugio.
model InscripcionEsterilizacion {
  id     Int               @id @default(autoincrement())
  estado EstadoInscripcion @default(PENDIENTE)

  // Datos de la mascota
  sexo         Sexo
  tamano       TamanoMascota
  pesoEstimado Float

  especieId Int
  especie   Especie @relation(fields: [especieId], references: [id], onDelete: Restrict)

  // Datos del tutor
  tutorNombre   String @db.VarChar(100)
  tutorApellido String @db.VarChar(100)
  tutorRut      String @db.VarChar(12)
  tutorEmail    String @db.VarChar(150)
  tutorComuna   String @db.VarChar(100)
  tutorSector   String @db.VarChar(100)

  // Lo completa la administradora al revisar y enviar la citación
  observaciones    String?   @db.Text
  fechaEnvioCorreo DateTime?

  jornadaId Int
  jornada   JornadaEsterilizacion @relation(fields: [jornadaId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jornadaId, estado])
  @@index([tutorRut])
  @@map("inscripciones_esterilizacion")
}
